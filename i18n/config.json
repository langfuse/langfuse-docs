{
  "$comment": "Configuration for scripts/translate/translate.mjs. See i18n/README.md.",
  "sourceLanguage": "en",
  "languages": {
    "fr": { "name": "French", "nativeName": "Français" },
    "ja": { "name": "Japanese", "nativeName": "日本語" },
    "ko": { "name": "Korean", "nativeName": "한국어" },
    "es": { "name": "Spanish", "nativeName": "Español" },
    "zh": { "name": "Simplified Chinese", "nativeName": "简体中文" }
  },
  "model": "claude-opus-5-5",
  "effort": "medium",
  "maxOutputTokens": 64000,
  "concurrency": 4,
  "maxSourceChars": 120000,
  "include": [
    "content/docs/**",
    "content/self-hosting/**",
    "content/integrations/**",
    "content/guides/**",
    "content/academy/**",
    "content/compare/**",
    "content/workshop/**"
  ],
  "exclude": [
    "content/docs/roadmap.mdx",
    "content/docs/v4.mdx",
    "content/self-hosting/v2/**",
    "content/self-hosting/oss-newsletter.mdx"
  ],
  "excludeByLanguage": {},
  "$neverTranslate": "Legal and contractual pages stay in English only, even if a later change to include covers them. Translations of these pages are removed.",
  "neverTranslate": [
    "content/security/**",
    "content/marketing/privacy.mdx",
    "content/marketing/cookie-policy.mdx",
    "content/marketing/imprint.mdx",
    "content/marketing/pricing.mdx",
    "content/marketing/pricing-self-host.mdx",
    "content/self-hosting/license-key.mdx",
    "content/docs/administration/billable-units.mdx"
  ]
}

{
  "name": "langfuse-docs",
  "version": "0.0.1",
  "description": "Langfuse docs",
  "scripts": {
    "agents:check": "bun scripts/agents/sync-agent-shims.mjs --check",
    "agents:sync": "bun scripts/agents/sync-agent-shims.mjs",
    "dev": "NODE_PATH=node_modules/.bun/node_modules bun --bun next dev -p 3333 -H 127.0.0.1",
    "sync-design-tokens": "bun scripts/sync-design-tokens.js && bun fmt public/design.md",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "bun fmt --check && bun check && bun scripts/check-h1-headings.js && bun run lint:middle-dot",
    "lint:middle-dot": "bun scripts/check-middle-dot.js",
    "postinstall": "bash scripts/postinstall.sh",
    "prebuild": "bun scripts/generate_brand_assets_zip.js && bun scripts/generate-default-og-png.mjs && bun scripts/authors/validate-contributors.js && bun run workshop:sync && bun scripts/copy_md_sources.js && bun scripts/generate-sitemap-excludes.js && bun scripts/sync-design-tokens.js",
    "build": "NODE_PATH=node_modules/.bun/node_modules bun --bun next build",
    "postbuild": "bun run postbuild:sitemap && bun run postbuild:llms-txt",
    "build:static": "STATIC_EXPORT=true bun run prebuild && STATIC_EXPORT=true NODE_PATH=node_modules/.bun/node_modules bun --bun next build && bun run postbuild:static",
    "postbuild:static": "bun run postbuild && bun scripts/generate-cloudflare-redirects.js && cp lib/_headers out/",
    "start": "bun --bun next start -p 3333",
    "analyze": "ANALYZE=true NODE_PATH=node_modules/.bun/node_modules bun --bun next build",
    "postbuild:sitemap": "bun --bun next-sitemap",
    "postbuild:llms-txt": "bun scripts/generate_llms_txt.js",
    "workshop:sync": "bun scripts/sync-workshop.mjs",
    "link-check": "bun scripts/check-links.js",
    "sitemap-check": "bun scripts/check-sitemap-links.js",
    "test": "bun test",
    "test:link-check": "bun test scripts/check-links.test.js scripts/check-sitemap-links.test.js",
    "test:mcp": "bun test scripts/mcp.test.mjs",
    "qa-chatbot:seed-general": "bun --no-env-file components/qaChatbot/datasets/seed_general_qa_chatbot_dataset.ts",
    "qa-chatbot:seed-sdk-grounding": "bun --no-env-file components/qaChatbot/datasets/seed_sdk_integration_grounding_dataset.ts",
    "qa-chatbot:setup-sdk-grounding-evaluators": "bun --no-env-file components/qaChatbot/evaluators/setup_sdk_integration_grounding_evaluators.ts",
    "qa-chatbot:general-experiment": "bun --no-env-file components/qaChatbot/experiments/run_general_qa_chatbot_experiment.ts",
    "qa-chatbot:sdk-grounding-experiment": "bun --no-env-file components/qaChatbot/experiments/run_sdk_integration_grounding_experiment.ts",
    "nuke": "rm -rf .next && rm -rf node_modules && bun install"
  },
  "engines": {
    "node": "^22.17.0"
  },
  "homepage": "https://docs.langfuse.com",
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.49",
    "@ai-sdk/mcp": "^2.0.40",
    "@ai-sdk/openai": "^4.0.51",
    "@ai-sdk/openai-compatible": "^3.0.40",
    "@ai-sdk/react": "^4.0.87",
    "@calcom/embed-react": "^1.5.3",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.2.2",
    "@icons-pack/react-simple-icons": "^13.7.0",
    "@inkeep/cxkit-react": "^0.5.119",
    "@langfuse/browser": "6.0.0",
    "@langfuse/client": "6.0.0",
    "@langfuse/core": "6.0.0",
    "@langfuse/openai": "6.0.0",
    "@langfuse/otel": "6.0.0",
    "@langfuse/tracing": "6.0.0",
    "@langfuse/vercel-ai-sdk": "6.0.0",
    "@mintlify/agent-traffic": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@next/third-parties": "^16.4.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-presence": "^1.1.10",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.2",
    "@rive-app/react-webgl2": "^4.27.3",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-table": "^8.20.6",
    "@typesafe-ai/sdk": "^0.5.7",
    "@vercel/functions": "^2.2.2",
    "@vercel/og": "^1.0.3",
    "@vercel/speed-insights": "^2.0.0",
    "@vidstack/react": "^1.12.13",
    "ai": "^7.0.84",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^11.15.0",
    "fumadocs-core": "^16.15.4",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.4",
    "geist": "^1.3.1",
    "gpt3-tokenizer": "^1.1.5",
    "harden-react-markdown": "^1.0.2",
    "hast-util-to-jsx-runtime": "^2.3.0",
    "katex": "^0.18.2",
    "langfuse": "^3.38.20",
    "livekit-client": "^2.17.1",
    "livekit-server-sdk": "^2.15.0",
    "lucide-react": "^0.577.0",
    "mcp-handler": "1.1.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "mermaid": "^12.3.0",
    "nanoid": "^5.1.16",
    "next": "^16.4.6",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "openai": "^6.22.0",
    "openai-edge": "^1.2.3",
    "postcss": "^8.5.33",
    "posthog-js": "^1.442.0",
    "posthog-node": "^5.49.1",
    "react": "^19.3.1",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.68.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^16.1.2",
    "react-tweet": "^3.2.2",
    "recharts": "^3.6.0",
    "rehype-katex": "^7.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-rehype": "^11.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.183.2",
    "unist-util-visit": "^5.0.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "22.18.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "esbuild": "^0.28.2",
    "markdown-link-check": "^3.15.0",
    "satori": "^0.33.5",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "xml2js": "^0.6.2",
    "yaml": "2.9.0"
  },
  "nextBundleAnalysis": {
    "budget": 358400,
    "budgetPercentIncreaseRed": 20,
    "minimumChangeThreshold": 500,
    "skipCommentIfEmpty": true,
    "showDetails": true
  },
  "//NODE_PATH": "Next.js requires @types/react to be resolvable but it is intentionally not a direct dependency: the app is not yet type-checked against React types. NODE_PATH points Next at the copy in Bun's store, as pnpm's bin shims used to.",
  "//overrides": [
    "mcp-handler: the adapter's exact peer requires an SDK version with security advisories.",
    "rehype-katex, micromark-extension-math: these Markdown math renderers declare the vulnerable KaTeX 0.16 line.",
    "satori: pins fflate 0.7.3, which lacks the decompression security fix."
  ],
  "overrides": {
    "mcp-handler@1.1.0>@modelcontextprotocol/sdk": "1.32.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "rehype-katex@7.0.1>katex": "0.18.2",
    "micromark-extension-math@3>katex": "0.18.2",
    "satori@0.33.5>fflate": "0.7.5"
  },
  "trustedDependencies": [
    "esbuild",
    "protobufjs",
    "sharp"
  ]
}
